source("clean_non_ascii.R")
# Script : clean_non_ascii.R
# But : Supprimer les caractères non-ASCII de tous les fichiers .R du dossier R/
clean_non_ascii_files <- function(path = "R") {
files <- list.files(path, pattern = "\\.R$", full.names = TRUE)
message("🔍 Fichiers détectés : ", length(files))
for (f in files) {
txt <- readLines(f, encoding = "UTF-8", warn = FALSE)
# Remplace les caractères non-ASCII par leur équivalent ou un simple remplacement
clean_txt <- iconv(txt, from = "UTF-8", to = "ASCII//TRANSLIT", sub = "")
if (!identical(txt, clean_txt)) {
writeLines(clean_txt, f, useBytes = TRUE)
message("✅ Nettoyé : ", basename(f))
} else {
message("✔ Aucun caractère non-ASCII : ", basename(f))
}
}
message("🎉 Nettoyage terminé.")
}
# Lancer le nettoyage
clean_non_ascii_files("R")
