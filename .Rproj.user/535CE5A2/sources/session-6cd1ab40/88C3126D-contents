#' Generer les resultats finaux a partir des resultats bruts
#'
#' @param case_f Data frame contenant les informations du cas apres association avec les eplets
#' @param res Data frame contenant les resultats bruts generes par `calculer_resultats`
#'
#' @return Liste contenant deux data frames :
#' \item{res_total}{Tous les resultats finaux avec regroupement des alleles et MFI}
#' \item{res_prob}{Resultats les plus probables (maximum couverture)}
#' @export
#'
#' @examples
#' # resultats <- generer_resultat_final(case_f, res)
generer_resultat_final <- function(case_f, res) {
  message(" Generation des resultats finaux...")

  # Verification colonnes necessaires
  required_cols_case <- c("allele", "MFI", "eplet", "self", "exposition", "status")
  required_cols_res <- c("eplet", "self", "exposition", "status", "pos", "neg")
  if (!all(required_cols_case %in% names(case_f))) {
    stop("case_f doit contenir les colonnes : ", paste(required_cols_case, collapse = ", "))
  }
  if (!all(required_cols_res %in% names(res))) {
    stop("res doit contenir les colonnes : ", paste(required_cols_res, collapse = ", "))
  }

  res_brut <- case_f %>%
    dplyr::left_join(res, by = c("eplet", "self", "exposition", "status")) %>%
    dplyr::select(-locus) %>%
    dplyr::rename_with(~stringr::str_c("NS_", .x), c("exposition", "status")) %>%
    dplyr::filter(!is.na(pos)) %>%
    tidyr::unite("S_NS", c(self, eplet), sep = "_") %>%
    dplyr::mutate(MFI = paste0("(", MFI, ")")) %>%
    tidyr::unite("all_MFI", c(allele, MFI), sep = " ") %>%
    dplyr::group_by(S_NS) %>%
    dplyr::mutate(alleles = stringr::str_c(all_MFI, collapse = ", ")) %>%
    dplyr::ungroup() %>%
    dplyr::select(-neg)

  res_total <- res_brut %>%
    dplyr::select(-all_MFI) %>%
    dplyr::arrange(dplyr::desc(pos)) %>%
    dplyr::distinct()

  # Resultat le plus probable (max couverture)
  res_prob <- res_brut %>%
    dplyr::filter(pos == max(pos), .by = all_MFI) %>%
    dplyr::select(-all_MFI) %>%
    dplyr::distinct() %>%
    dplyr::arrange(dplyr::desc(pos))

  return(list(
    res_total = res_total,
    res_prob = res_prob
  ))
}

