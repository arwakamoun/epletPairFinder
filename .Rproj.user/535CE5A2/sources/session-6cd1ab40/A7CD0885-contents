# Script : clean_non_ascii.R
# But : Supprimer les caracteres non-ASCII de tous les fichiers .R du dossier R/

clean_non_ascii_files <- function(path = "R") {
  files <- list.files(path, pattern = "\\.R$", full.names = TRUE)
  message(" Fichiers detectes : ", length(files))

  for (f in files) {
    txt <- readLines(f, encoding = "UTF-8", warn = FALSE)

    # Remplace les caracteres non-ASCII par leur equivalent ou un simple remplacement
    clean_txt <- iconv(txt, from = "UTF-8", to = "ASCII//TRANSLIT", sub = "")

    if (!identical(txt, clean_txt)) {
      writeLines(clean_txt, f, useBytes = TRUE)
      message("? Nettoye : ", basename(f))
    } else {
      message("? Aucun caractere non-ASCII : ", basename(f))
    }
  }
  message(" Nettoyage termine.")
}

# Lancer le nettoyage
clean_non_ascii_files("R")
